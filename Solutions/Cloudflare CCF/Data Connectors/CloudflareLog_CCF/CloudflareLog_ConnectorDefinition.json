{
    "name": "CloudflareDefinition",
    "apiVersion": "2022-09-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "CloudflareDefinition",
            "title": "Cloudflare (Using Blob Container) (via Codeless Connector Framework)",
            "publisher": "Microsoft",
            "descriptionMarkdown": "The Cloudflare data connector provides the capability to ingest Cloudflare logs into Microsoft Sentinel using the Cloudflare Logpush and Azure Blob Storage. Refer to [Cloudflare documentation](https://developers.cloudflare.com/logs/about/) for more information",
            "graphQueriesTableName": "CloudflareV2_CL",
            "graphQueries": [
                {
                    "metricName": "Total events received",
                    "legend": "Cloudflare logs",
                    "baseQuery": "{{graphQueriesTableName}}"
                }
            ],
            "sampleQueries": [
                {
                    "description": "Cloudflare Logs",
                    "query": "{{graphQueriesTableName}}\n | take 10"
                }
            ],
            "dataTypes": [
                {
                    "name": "{{graphQueriesTableName}}",
                    "lastDataReceivedQuery": "{{graphQueriesTableName}}\n|summarize Time = max(TimeGenerated)\n|where isnotempty(Time)"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors"
                }
            ],
            "availability": {
                "status": 1,
                "isPreview": false
            },
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "read": true,
                            "write": true,
                            "delete": true,
                            "action": false
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "Create a storage account and a container",
                        "description": "Before setting up logpush in Cloudflare, first create a storage account and a container in Microsoft Azure. Use [this guide](https://learn.microsoft.com/en-us/azure/storage/blobs/storage-blobs-introduction) to know more about Container and Blob. Follow the steps in the [documentation](https://learn.microsoft.com/en-us/azure/storage/common/storage-account-create?tabs=azure-portal) to create an Azure Storage account."
                    },
                    {
                        "name": "Generate a Blob SAS URL",
                        "description": "Create and Write permissions are required. Refer the [documentation](https://learn.microsoft.com/en-us/azure/ai-services/translator/document-translation/how-to-guides/create-sas-tokens?tabs=Containers) to know more about Blob SAS token and url."
                    },
                    {
                        "name": "Collecting logs from Cloudflare to your Blob container",
                        "description": "Follow the steps in the [documentation](https://developers.cloudflare.com/logs/get-started/enable-destinations/azure/) for collecting logs from Cloudflare to your Blob container."
                    }
                ]
            },
            "instructionSteps": [
                {
                    "title": "Connect Cloudflare accounts to Microsoft Sentinel",
                    "description": "Each Cloudflare account is ingested through its own data collection rule, data collection endpoint, Sentinel data connector and storage queues. Use the grid below to view existing collectors and click **Add new collector** to add another Cloudflare account.",
                    "instructions": [
                        {
                            "type": "Markdown",
                            "parameters": {
                                "content": "#### 1. Configure Cloudflare Logpush to write to an Azure Blob container\nBefore adding a collector here, follow the [Cloudflare documentation](https://developers.cloudflare.com/logs/get-started/enable-destinations/azure/) to push logs from each Cloudflare account into its own Azure storage account / blob container.\n\n#### 2. Add a new collector for each Cloudflare account\nClick **Add new collector**, fill in the required information in the context pane, and click **Connect**. Repeat once per Cloudflare account."
                            }
                        },
                        {
                            "type": "DataConnectorsGrid",
                            "parameters": {
                                "mapping": [
                                    {
                                        "columnName": "Connector",
                                        "columnValue": "name"
                                    },
                                    {
                                        "columnValue": "properties.request.queueUri",
                                        "columnName": "Queue URL"
                                    },
                                    {
                                        "columnValue": "properties.isActive",
                                        "columnName": "Active"
                                    }
                                ],
                                "menuItems": [
                                    "DeleteConnector"
                                ]
                            }
                        },
                        {
                            "type": "ContextPane",
                            "parameters": {
                                "contextPaneType": "DataConnectorsContextPane",
                                "title": "Add a Cloudflare account",
                                "subtitle": "Cloudflare (Using Blob Container)",
                                "label": "Add new collector",
                                "instructionSteps": [
                                    {
                                        "title": "Cloudflare account details",
                                        "instructions": [
                                            {
                                                "type": "ServicePrincipalIDTextBox_test",
                                                "parameters": {
                                                    "tenantId": "[subscription().tenantId]",
                                                    "name": "principalId",
                                                    "appId": "4f05ce56-95b6-4612-9d98-a45c8cc33f9f"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Cloudflare account name",
                                                    "description": "A short, lowercase identifier for this Cloudflare account (letters, digits and hyphens). Used as a prefix when naming the DCR, DCE, data connector and storage queues created for this account.",
                                                    "type": "text",
                                                    "name": "CloudflareAccountName",
                                                    "validations": {
                                                        "required": true
                                                    }
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Storage account name",
                                                    "description": "The name of the Azure Storage account that receives Cloudflare Logpush data.",
                                                    "type": "text",
                                                    "name": "StorageAccountName",
                                                    "validations": {
                                                        "required": true
                                                    }
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Blob container name",
                                                    "description": "The blob container inside the storage account where Cloudflare Logpush writes log files.",
                                                    "type": "text",
                                                    "name": "ContainerName",
                                                    "validations": {
                                                        "required": true
                                                    }
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Storage account resource group",
                                                    "type": "text",
                                                    "name": "StorageAccountResourceGroupName",
                                                    "validations": {
                                                        "required": true
                                                    }
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Storage account subscription id",
                                                    "type": "text",
                                                    "name": "StorageAccountSubscription",
                                                    "validations": {
                                                        "required": true
                                                    }
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "The event grid topic name of the blob container's storage account if exist. else keep empty.",
                                                    "description": "Azure Event Grid allows only one system topic per storage account. If a previous Cloudflare collector already created a system topic for this storage account, paste its name here (e.g. 'sentinel-cloudflare-<storage-account-name>') so this deployment reuses it and only adds a new event subscription. To find it, open the storage account in the Azure portal and go to 'Events'. Leave this empty only when deploying the first collector against this storage account.",
                                                    "type": "text",
                                                    "name": "EGSystemTopicName",
                                                    "validations": {
                                                        "required": false
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            ],
            "isConnectivityCriteriasMatchSome": false
        }
    },
    "dependsOn": null
}
